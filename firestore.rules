rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function verifiedOwner(uid) {
      return isOwner(uid) && emailVerified();
    }

    function isRoutineImportPurpose(purpose) {
      return purpose == "class_timetable"
        || purpose == "work_schedule"
        || purpose == "eating_menu"
        || purpose == "skin_care";
    }

    function validUploadPurpose(purpose) {
      return isRoutineImportPurpose(purpose)
        || purpose == "profile_photo";
    }

    function validUploadContentType(purpose, contentType) {
      return purpose == "profile_photo"
        ? contentType == "image/jpeg"
          || contentType == "image/jpg"
          || contentType == "image/png"
        : isRoutineImportPurpose(purpose)
          && (contentType == "image/jpeg"
            || contentType == "image/jpg"
            || contentType == "image/png"
            || contentType == "image/webp");
    }

    function isValidUploadSize(purpose, sizeBytes) {
      return purpose == "profile_photo"
        ? sizeBytes > 0 && sizeBytes <= 5242880
        : isRoutineImportPurpose(purpose)
          && sizeBytes > 0
          && sizeBytes <= 15728640;
    }

    function validUploadStatus(status) {
      return status == "pending"
        || status == "uploading"
        || status == "uploaded"
        || status == "failed"
        || status == "deleted";
    }

    function validUploadKeys(data) {
      return data.keys().hasOnly([
        "assetId",
        "ownerUid",
        "sourceFeature",
        "purpose",
        "fileName",
        "contentType",
        "sizeBytes",
        "r2Key",
        "status",
        "createdAt",
        "updatedAt",
        "errorMessage"
      ])
      && !data.keys().hasAny(["localPreviewPath", "imageBytes", "bytes"]);
    }

    function validRoutineImportReviewStatus(status) {
      return status == "draft"
        || status == "needsReview"
        || status == "accepted"
        || status == "partiallyAccepted"
        || status == "rejected";
    }

    function validRoutineImportReviewSource(source) {
      return source == "classes"
        || source == "work"
        || source == "eating"
        || source == "skinCare";
    }

    function validRoutineImportReviewKeys(data) {
      return data.keys().hasOnly([
        "id",
        "uid",
        "source",
        "status",
        "sourceLabel",
        "onboardingPendingImportId",
        "uploadedAssetId",
        "uploadedAssetR2Key",
        "uploadedAssetStatus",
        "candidateBlocks",
        "warnings",
        "acceptedCandidateIds",
        "rejectedCandidateIds",
        "appliedRoutineItemIds",
        "appliedAt",
        "extractionEngine",
        "extractionVersion",
        "lastExtractedAt",
        "extractionWarnings",
        "extractionAttemptCount",
        "createdAt",
        "updatedAt"
      ])
      && !data.keys().hasAny([
        "routineItems",
        "imageBytes",
        "localPath",
        "localFilePath",
        "localPreviewPath"
      ]);
    }

    function validRoutineImportReview(data, reviewId) {
      return data.uid == request.auth.uid
        && (!data.keys().hasAny(["id"]) || data.id == reviewId)
        && validRoutineImportReviewKeys(data)
        && validRoutineImportReviewSource(data.source)
        && validRoutineImportReviewStatus(data.status)
        && data.sourceLabel is string
        && data.candidateBlocks is list
        && data.warnings is list
        && data.acceptedCandidateIds is list
        && data.rejectedCandidateIds is list
        && data.appliedRoutineItemIds is list
        && data.extractionAttemptCount is int
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Strict Phase 2A upload metadata rule. R2 bytes are owned by the Worker;
    // Firestore stores only verified owner metadata.
    match /users/{uid}/uploads/{assetId} {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && validUploadKeys(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.assetId == assetId
        && request.resource.data.sizeBytes is int
        && isValidUploadSize(
          request.resource.data.purpose,
          request.resource.data.sizeBytes
        )
        && validUploadContentType(
          request.resource.data.purpose,
          request.resource.data.contentType
        )
        && request.resource.data.sourceFeature == "onboarding"
        && request.resource.data.r2Key is string
        && request.resource.data.fileName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && validUploadPurpose(request.resource.data.purpose)
        && validUploadStatus(request.resource.data.status);
      allow delete: if false;
    }

    // Strict Phase 2C/2D visual review rule. AI only writes review candidates;
    // Routine items are not created by this collection.
    match /users/{uid}/routineImportReviews/{reviewId} {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && validRoutineImportReview(request.resource.data, reviewId);
      allow delete: if false;
    }

    // Phase 2B onboarding draft/completion bundle. Validation stays light for
    // early development; production backend modules must add specific schemas.
    match /users/{uid}/onboarding/{docId} {
      allow read, write: if verifiedOwner(uid);
    }

    match /users/{uid} {
      allow read, write: if verifiedOwner(uid);
    }

    // Temporary verified-owner development catchall.
    // Home/Routine/Tracker/Goals/Coach backend collections must get specific
    // collection rules before production release. Uploads and import reviews
    // are excluded here because their stricter rules above already apply.
    match /users/{uid}/{collectionId}/{document=**} {
      allow read, write: if verifiedOwner(uid)
        && collectionId != "uploads"
        && collectionId != "routineImportReviews";
    }
  }
}
