      allow create, update: if verifiedOwner(uid)
        && validProfileSubdoc(request.resource.data);
      allow delete: if verifiedOwner(uid);
    }

    // PATH3-SEC-03: User Profile strict schema validation
    match /users/{uid} {
      allow read: if verifiedOwner(uid);
      allow create: if verifiedOwner(uid)
        && validUserProfile(request.resource.data, uid);
      allow update: if verifiedOwner(uid)
        && validUserProfile(request.resource.data, uid)
        && (!resource.data.keys().hasAny(["uid"]) || request.resource.data.uid == resource.data.uid)
        && (!resource.data.keys().hasAny(["createdAt"]) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if verifiedOwner(uid);
    }
