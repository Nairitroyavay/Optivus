    match /users/{uid}/coachSessions/{sessionId} {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && validCoachSession(request.resource.data, sessionId);
      allow delete: if verifiedOwner(uid);
    }

    match /users/{uid}/coach/{docId} {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && validCoachPreferences(request.resource.data);
      allow delete: if verifiedOwner(uid);
    }

    match /users/{uid}/coach/{docId}/{subcollection}/{subDocId} {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && (docId == "preferences" ? validCoachPreferences(request.resource.data) : validCoachSession(request.resource.data, subDocId));
      allow delete: if verifiedOwner(uid);
    }

    match /users/{uid}/mindNotes/{noteId} {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && validMindNote(request.resource.data, noteId);
      allow delete: if verifiedOwner(uid);
