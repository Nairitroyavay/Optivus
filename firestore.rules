    match /users/{uid}/settings/appPreferences {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && validAppPreferences(request.resource.data, uid);
      allow delete: if verifiedOwner(uid);
    }

    match /users/{uid}/notifications/{docId} {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && validNotificationPreferences(request.resource.data);
      allow delete: if verifiedOwner(uid);
    }

    match /users/{uid}/notifications/{docId}/{subcollection}/{subDocId} {
